[
    {
        "key": "ctrl+alt+i",
        "command": "-workbench.action.chat.open"
    },
    {
        "key": "ctrl+alt+i",
        "command": "claude-vscode.sidebar.open",
        "when": "!claude-vscode.sideBarActive"
    },
    {
        "key": "ctrl+alt+i",
        "command": "workbench.action.closeAuxiliaryBar",
        "when": "claude-vscode.sideBarActive"
    }
]
